# 本文件提供 Linux 生产部署所需的环境变量模板，复制后必须替换所有 CHANGE_ME 值。
MYSQL_DATABASE=bugloop
MYSQL_USERNAME=bugloop
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# 开启后启动时自动创建内置系统管理员（账号已存在则跳过）；不需要内置账号时改为 false。
BUGLOOP_ADMIN_BOOTSTRAP_ENABLED=true
# 内置管理员账号与初始密码，首次登录后请修改密码并同步更新这里，避免保留默认口令。
BUGLOOP_ADMIN_USERNAME=admin
BUGLOOP_ADMIN_PASSWORD=admin@123

# 直接通过服务器 IP 访问时使用 0.0.0.0；若前面另有 HTTPS 反向代理，建议改为 127.0.0.1。
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# 限制 JVM 使用容器可用内存的比例，避免与 MySQL、Nginx 争抢全部内存。
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -Dfile.encoding=UTF-8
